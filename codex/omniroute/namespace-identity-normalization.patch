 }
+
+export function resolveNamespaceIdentity(
+  map: ReadonlyMap<string, unknown> | null | undefined,
+  toolName: string
+): NamespaceIdentity | null {
+  if (!(map instanceof Map) || !toolName) return null;
+
+  const direct = map.get(toolName);
+  if (
+    direct &&
+    typeof direct === "object" &&
+    typeof (direct as NamespaceIdentity).namespace === "string" &&
+    typeof (direct as NamespaceIdentity).name === "string"
+  ) {
+    return direct as NamespaceIdentity;
+  }
+
+  const normalize = (value: string) =>
+    value
+      .trim()
+      .replace(/[^a-zA-Z0-9_]/g, "_")
+      .replace(/_+/g, "_")
+      .replace(/^_+|_+$/g, "");
+  const normalizedName = normalize(toolName);
+  const matches: NamespaceIdentity[] = [];
+  for (const value of map.values()) {
+    if (
+      !value ||
+      typeof value !== "object" ||
+      typeof (value as NamespaceIdentity).namespace !== "string" ||
+      typeof (value as NamespaceIdentity).name !== "string"
+    ) {
+      continue;
+    }
+    const identity = value as NamespaceIdentity;
+    if (
+      [
+        `${identity.namespace}__${identity.name}`,
+        `${identity.namespace}_${identity.name}`,
+        `${identity.namespace}.${identity.name}`,
+      ].some((candidate) => normalize(candidate) === normalizedName)
+    ) {
+      matches.push(identity);
+    }
+  }
+  return matches.length === 1 ? matches[0] : null;
+}
