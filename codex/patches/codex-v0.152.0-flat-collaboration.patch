+const LEGACY_COLLABORATION_TOOLS: &[&str] = &[
+    "spawn_agent",
+    "wait",
+    "wait_agent",
+    "send_input",
+    "resume_agent",
+    "close_agent",
+    "send_message",
+    "followup_task",
+    "interrupt_agent",
+    "list_agents",
+];
+
+fn normalize_flat_collaboration_tool_name(
+    namespace: Option<String>,
+    name: String,
+) -> (Option<String>, String) {
+    let namespace = namespace.filter(|value| !value.trim().is_empty());
+    if namespace.is_some() {
+        return (namespace, name);
+    }
+
+    for (prefix, canonical_namespace) in [
+        ("multi_agent_v1_", "multi_agent_v1"),
+        ("collaboration_", "collaboration"),
+    ] {
+        let Some(candidate) = name.strip_prefix(prefix) else {
+            continue;
+        };
+        let candidate = candidate.strip_prefix('_').unwrap_or(candidate);
+        for tool in LEGACY_COLLABORATION_TOOLS {
+            let suffix = candidate.strip_prefix(tool);
+            let valid_suffix = suffix.is_none_or(|rest| {
+                rest.starts_with('_') && rest[1..].chars().all(|ch| ch.is_ascii_alphanumeric())
+            });
+            if valid_suffix {
+                return (Some(canonical_namespace.to_string()), (*tool).to_string());
+            }
+        }
+    }
+
+    if LEGACY_COLLABORATION_TOOLS.contains(&name.as_str()) {
+        return (Some("multi_agent_v1".to_string()), name);
+    }
+
+    (namespace, name)
+}
