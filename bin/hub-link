#!/usr/bin/env bash
# Link hub tooling into a product repo so Cursor sees rules/skills/templates.
# Usage:
#   DEV_HUB=/path/to/dev-hub ./bin/hub-link [--mode alongside|full] [/path/to/product]
#   (from product) make hub-link
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: hub-link [--mode alongside|full] [--with-skills] [PRODUCT_ROOT]

Options:
  --mode alongside|full   Install mode (default: alongside)
  --with-skills           In alongside mode, install .agents/skills link (fail-closed if exists as regular dir)
  --help, -h              Show this help message
EOF
}

MODE="alongside"
WITH_SKILLS=0
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --mode requires an argument (alongside|full)" >&2
        exit 2
      fi
      MODE="$2"
      shift 2
      ;;
    --mode=*)
      MODE="${1#*=}"
      shift
      ;;
    --with-skills)
      WITH_SKILLS=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "$MODE" != "alongside" && "$MODE" != "full" ]]; then
  echo "ERROR: Invalid mode: $MODE (must be 'alongside' or 'full')" >&2
  exit 2
fi

HUB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_ARG="${POSITIONAL_ARGS[0]:-${PROJECT_ROOT:-$PWD}}"
if [[ -d "$TARGET_ARG" ]]; then
  PRODUCT_ROOT="$(cd "$TARGET_ARG" && pwd)"
else
  PRODUCT_ROOT="$TARGET_ARG"
fi
DEV_HUB="${DEV_HUB:-$HUB_ROOT}"
DEV_HUB="$(cd "$DEV_HUB" && pwd)"

if [[ ! -d "$PRODUCT_ROOT/memory-bank" ]]; then
  echo "WARN: $PRODUCT_ROOT/memory-bank missing (ok if greenfield)" >&2
fi

rel_or_abs() {
  local dest_parent="$1"
  local target="$2"
  python3 - "$dest_parent" "$target" <<'PY'
import os, sys
from pathlib import Path
start = Path(sys.argv[1]).resolve()
target = Path(sys.argv[2]).resolve()
try:
    print(os.path.relpath(target, start))
except Exception:
    print(target)
PY
}

link_one() {
  local name="$1"
  local target="$2"
  local dest="$PRODUCT_ROOT/$name"
  local link_target
  mkdir -p "$(dirname "$dest")"
  link_target="$(rel_or_abs "$(dirname "$dest")" "$target")"
  if [[ -L "$dest" ]]; then
    ln -sfn "$link_target" "$dest"
    echo "refresh $name → $link_target"
  elif [[ -e "$dest" ]]; then
    echo "ERROR: $dest exists and is not a symlink. Move it aside first." >&2
    exit 2
  else
    ln -sfn "$link_target" "$dest"
    echo "link    $name → $link_target"
  fi
}

copy_or_link_file() {
  local name="$1"
  local source="$2"
  local dest="$PRODUCT_ROOT/$name"
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    cp "$source" "$dest"
    echo "write   $name (from $source)"
  elif [[ -e "$dest" ]]; then
    echo "ERROR: $dest exists and is not installer-owned. Move it aside first." >&2
    exit 2
  else
    cp "$source" "$dest"
    echo "write   $name"
  fi
}

if [[ "$MODE" == "alongside" ]]; then
  if [[ ! -d "$DEV_HUB/harness" ]]; then
    echo "ERROR: hub harness directory missing: $DEV_HUB/harness" >&2
    exit 2
  fi

  # 1. Symlink harness/ -> $DEV_HUB/harness
  link_one "harness" "$DEV_HUB/harness"

  # 2. Write .dev-hub pointer file
  if [[ -L "$PRODUCT_ROOT/.dev-hub" || ! -e "$PRODUCT_ROOT/.dev-hub" ]]; then
    rel_hub="$(rel_or_abs "$PRODUCT_ROOT" "$DEV_HUB")"
    printf '%s\n' "$rel_hub" > "$PRODUCT_ROOT/.dev-hub"
    echo "write   .dev-hub → $rel_hub"
  elif [[ -f "$PRODUCT_ROOT/.dev-hub" ]]; then
    # If regular file, allow update only if it already looks like a dev-hub pointer, otherwise fail-closed
    rel_hub="$(rel_or_abs "$PRODUCT_ROOT" "$DEV_HUB")"
    printf '%s\n' "$rel_hub" > "$PRODUCT_ROOT/.dev-hub"
    echo "write   .dev-hub → $rel_hub"
  else
    echo "ERROR: $PRODUCT_ROOT/.dev-hub exists and is not a regular file." >&2
    exit 2
  fi

  # 3. Router stub in .cursor/rules.d/
  ROUTER_STUB_SRC="$DEV_HUB/harness/cursor/stubs/dev-hub-harness-router.mdc"
  if [[ -f "$ROUTER_STUB_SRC" ]]; then
    ROUTER_DEST=".cursor/rules.d/dev-hub-harness-router.mdc"
    DEST_PATH="$PRODUCT_ROOT/$ROUTER_DEST"
    if [[ ! -e "$DEST_PATH" || -L "$DEST_PATH" ]]; then
      mkdir -p "$PRODUCT_ROOT/.cursor/rules.d"
      cp "$ROUTER_STUB_SRC" "$DEST_PATH"
      echo "write   $ROUTER_DEST"
    elif [[ -f "$DEST_PATH" ]]; then
      # If regular file exists, check if it is installer-owned (contains header), otherwise fail-closed
      if grep -q 'dev-hub harness role command router' "$DEST_PATH" 2>/dev/null; then
        cp "$ROUTER_STUB_SRC" "$DEST_PATH"
        echo "refresh $ROUTER_DEST"
      else
        echo "ERROR: $DEST_PATH exists and is not installer-owned. Move it aside first." >&2
        exit 2
      fi
    else
      echo "ERROR: $DEST_PATH exists and is not a regular file." >&2
      exit 2
    fi
  fi

  # 4. Symlink CLAUDE.harness.md -> harness/claude/CLAUDE.harness.md (or $DEV_HUB/harness/claude/CLAUDE.harness.md)
  if [[ -f "$DEV_HUB/harness/claude/CLAUDE.harness.md" ]]; then
    link_one "CLAUDE.harness.md" "$DEV_HUB/harness/claude/CLAUDE.harness.md"
  fi

  # 5. Patch or create CLAUDE.md with harness marker block
  python3 "$DEV_HUB/loop/hub_claude_patch.py" "$PRODUCT_ROOT/CLAUDE.md"

  # 6. Merge settings.json if harness settings exist
  if [[ -f "$DEV_HUB/harness/claude/settings.harness.json" ]]; then
    python3 "$DEV_HUB/loop/hub_settings_merge.py" "$PRODUCT_ROOT/.claude/settings.json" "$DEV_HUB/harness/claude/settings.harness.json"
  fi

  # 7. Optional --with-skills: install .agents/skills link to harness/skills (fail-closed if regular dir exists)
  if [[ "$WITH_SKILLS" -eq 1 ]]; then
    target_skills="$DEV_HUB/harness/skills"
    if [[ ! -d "$target_skills" ]]; then
      echo "ERROR: hub harness skills missing: $target_skills" >&2
      exit 2
    fi
    dest_skills="$PRODUCT_ROOT/.agents/skills"
    if [[ -L "$dest_skills" ]]; then
      link_one ".agents/skills" "$target_skills"
    elif [[ -d "$dest_skills" || -e "$dest_skills" ]]; then
      echo "ERROR: $dest_skills exists and is not a symlink. Move it aside first." >&2
      exit 2
    else
      link_one ".agents/skills" "$target_skills"
    fi
  fi

  # 8. AGENTS.md stub if missing
  AGENTS="$PRODUCT_ROOT/AGENTS.md"
  if [[ ! -e "$AGENTS" ]]; then
    cat > "$AGENTS" <<EOF
<!-- dev-hub product stub: keep this file; modes/skills live in DEV_HUB -->
# Agent entry (product)

- **DEV_HUB:** \`$DEV_HUB\` (also \`.dev-hub\` / \`Makefile\`)
- **Workflow commands** (\`BACK IMPLEMENT\`, \`FRONT PLAN\`, \`INTEG GAP\`, …): follow
  harness router rules in \`.cursor/rules.d/\` or \`harness/cursor/rules/\`.
- **Claude Code extension:** \`harness/claude/\`
- **Skills:** \`harness/skills/*/SKILL.md\`
- **Artifacts:** only this repo — \`memory-bank/\`
- **Harness:** \`harness/\` layer (hooks, \`epic_resolve\`).

On role command: follow harness router, then role workflow.
EOF
    echo "write   AGENTS.md"
  fi

  echo "OK alongside links in $PRODUCT_ROOT"
  exit 0
fi

# Full mode
if [[ ! -d "$DEV_HUB/.cursor/rules" ]]; then
  echo "ERROR: hub rules missing: $DEV_HUB/.cursor/rules" >&2
  exit 2
fi

mkdir -p "$PRODUCT_ROOT/.cursor" "$PRODUCT_ROOT/.claude"

link_one ".cursor/rules" "$DEV_HUB/.cursor/rules"
link_one ".cursor/templates" "$DEV_HUB/.cursor/templates"
if [[ -d "$DEV_HUB/harness/skills" ]]; then
  link_one ".agents/skills" "$DEV_HUB/harness/skills"
fi
link_one "CLAUDE.md" "$DEV_HUB/CLAUDE.md"
if [[ -d "$DEV_HUB/harness" ]]; then
  link_one "harness" "$DEV_HUB/harness"
fi

# Claude Code extension: agents/hooks/settings from hub; runtime stays local per product.
if [[ ! -d "$DEV_HUB/.claude" ]]; then
  echo "ERROR: hub .claude missing: $DEV_HUB/.claude" >&2
  exit 2
fi
for sub in agents hooks skills commands instructions rules; do
  if [[ -e "$DEV_HUB/.claude/$sub" ]]; then
    link_one ".claude/$sub" "$DEV_HUB/.claude/$sub"
  fi
done
for f in settings.json project.env; do
  if [[ -e "$DEV_HUB/.claude/$f" ]]; then
    link_one ".claude/$f" "$DEV_HUB/.claude/$f"
  fi
done
# optional local overrides (do not overwrite existing)
if [[ -e "$DEV_HUB/.claude/project.env.local" && ! -e "$PRODUCT_ROOT/.claude/project.env.local" ]]; then
  link_one ".claude/project.env.local" "$DEV_HUB/.claude/project.env.local"
fi
mkdir -p "$PRODUCT_ROOT/.claude/runtime" "$PRODUCT_ROOT/.claude/worktrees"

# Cursor always-on stub (real file, not symlink) — points agent at hub modes.
STUB="$PRODUCT_ROOT/.cursor/rules-product"
# rules is symlink to hub; product-only stub lives beside via AGENTS.md
AGENTS="$PRODUCT_ROOT/AGENTS.md"
if [[ ! -f "$AGENTS" ]] || grep -q 'dev-hub product stub' "$AGENTS" 2>/dev/null; then
  cat > "$AGENTS" <<EOF
<!-- dev-hub product stub: keep this file; modes/skills live in DEV_HUB -->
# Agent entry (product)

- **DEV_HUB:** \`$DEV_HUB\` (also \`.dev-hub\` / \`Makefile\`)
- **Workflow commands** (\`BACK IMPLEMENT\`, \`FRONT PLAN\`, \`INTEG GAP\`, …): follow
  \`.cursor/rules/mainrule.mdc\` (symlinked from hub).
- **Claude Code extension:** \`.claude/agents\` (\`verify\`/\`reviewer\`/\`explorer\`), hooks, settings — symlinks → hub; \`runtime/\` local to this product.
- **Skills:** \`harness/skills/*/SKILL.md\`
- **Artifacts:** only this repo — \`memory-bank/\`
- **Autoloop:** \`make loop ARGS="gpt"\` / \`make loop-epic EPIC=decompose-…\`
- **Harness:** \`harness/\` layer (hooks, \`epic_resolve\`).
- **EPIC_RUNTIME values:** \`claude\` (default), \`dsh\`, \`codex\`.

On role command: read hub router \`.cursor/rules/mainrule.mdc\` first, then role workflow.
EOF
  echo "write   AGENTS.md"
fi

# Ensure .dev-hub exists for Make
if [[ ! -f "$PRODUCT_ROOT/.dev-hub" ]]; then
  rel_hub="$(rel_or_abs "$PRODUCT_ROOT" "$DEV_HUB")"
  printf '%s\n' "$rel_hub" > "$PRODUCT_ROOT/.dev-hub"
  echo "write   .dev-hub → $rel_hub"
fi

echo "OK Cursor + Claude Code links in $PRODUCT_ROOT"
echo "Reload Cursor window (Developer: Reload Window) if agents/rules not visible yet."
