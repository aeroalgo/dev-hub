#!/usr/bin/env bash
# Run the single-cursor loop against a product repo.
# Usage:
#   ./bin/loop /path/to/project run --epic E1 --model <model>
#   PROJECT_ROOT=/path/to/project ./bin/loop run --epic E1 --model <model>
set -euo pipefail
HUB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cd "$HUB_ROOT"
  exec python3 -m loop.kernel "$@"
fi

case "${1:-}" in
  claude|codex)
    export EPIC_RUNTIME="$1"
    shift
    export PROJECT_ROOT="$(pwd)"
    ;;
esac

if [[ $# -ge 1 && -d "${1:-}" && -d "${1}/memory-bank" ]]; then
  export PROJECT_ROOT="$(cd "$1" && pwd)"
  shift
elif [[ -z "${PROJECT_ROOT:-}" && $# -ge 1 ]]; then
  case "$1" in
    */*|.|..|~|~/*)
      echo "Project path does not exist or is not a dev-hub project: $1" >&2
      exit 2
      ;;
  esac
  if [[ -d "./memory-bank" ]]; then
    export PROJECT_ROOT="$(pwd)"
  else
    echo "Usage: $0 <project-root> [loop args...]" >&2
    echo "   or: PROJECT_ROOT=/path/to/project $0 [loop args...]" >&2
    exit 2
  fi
elif [[ -z "${PROJECT_ROOT:-}" && -d "./memory-bank" ]]; then
  export PROJECT_ROOT="$(pwd)"
elif [[ -z "${PROJECT_ROOT:-}" ]]; then
  echo "Usage: $0 <project-root> [loop args...]" >&2
  echo "   or: PROJECT_ROOT=/path/to/project $0 [loop args...]" >&2
  exit 2
fi

export DEV_HUB="$HUB_ROOT"
export HUB_ROOT
export CLAUDE_PROJECT_DIR="$HUB_ROOT"

cd "$HUB_ROOT"
exec python3 -m loop.kernel "$@"
