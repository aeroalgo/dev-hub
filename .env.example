EPIC_RUNTIME=codex
CODEX_USE_OMNIROUTE=1
OMNIROUTE_API_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY_FILE=~/.codex/.omniroute_key
LOOP_SESSION_TIMEOUT=3600
LOOP_MAX_ATTEMPTS=3
LOOP_MAX_STEPS=100
LOOP_RETRY_BACKOFF=2
LOOP_WORKFLOW_HOOKS=loop

# Explicit --model wins. Otherwise selection is step -> phase -> default.
# LOOP_MODEL=...
# LOOP_MODEL_IMPLEMENT=...
# LOOP_STEP_MODELS={"S01":"...","QA":"..."}

# --- Board projection (per-project; never commit real values) ---
# Shared yaml: .loop/board-projection.yaml (phase_alias + project_docs.files only)
# Board identity for THIS project/board:
LOOP_BOARD_PROVIDER=bitrix24

# Bitrix24
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/USER/CODE/
BITRIX_GROUP_ID=26
BITRIX_RESPONSIBLE_ID=274
BITRIX_STAGE_BACKLOG=1342
BITRIX_STAGE_DESIGN=1343
BITRIX_STAGE_BUILD=1344
BITRIX_STAGE_VERIFY=1345
BITRIX_STAGE_UAT=1347
BITRIX_STAGE_DONE=1346
# optional instead of per-key: BITRIX_STAGE_MAP={"backlog":"1342","design":"1343",...}

# Plane (when LOOP_BOARD_PROVIDER=plane)
# PLANE_API_KEY=
# PLANE_BASE_URL=https://app.plane.so
# PLANE_WORKSPACE_SLUG=
# PLANE_PROJECT_ID=
# PLANE_STATE_BACKLOG=
# PLANE_STATE_DESIGN=
# PLANE_STATE_BUILD=
# PLANE_STATE_VERIFY=
# PLANE_STATE_UAT=
# PLANE_STATE_DONE=
# optional: PLANE_STATE_MAP={"backlog":"..."}

# Docs folder on Bitrix Disk / Plane pages label
PROJECT_DOCS_FOLDER=docs
