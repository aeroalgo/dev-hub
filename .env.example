EPIC_RUNTIME=codex
CODEX_USE_OMNIROUTE=1
OMNIROUTE_API_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY_FILE=~/.codex/.omniroute_key
CODEX_ALLOW_UNPATCHED=0

LOOP_SESSION_TIMEOUT=3600
LOOP_MAX_ATTEMPTS=3
LOOP_MAX_STEPS=100
LOOP_RETRY_BACKOFF=2
LOOP_WORKFLOW_HOOKS=loop

# Explicit --model wins. Otherwise selection is step -> phase -> default.
# LOOP_MODEL=...
# LOOP_MODEL_IMPLEMENT=...
# LOOP_STEP_MODELS={"S01":"...","QA":"..."}
