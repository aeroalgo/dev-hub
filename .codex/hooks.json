{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 harness/hooks/session-start.py"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 harness/hooks/user-prompt.py"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 harness/hooks/pretool-dispatch.py",
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 harness/hooks/posttool-dispatch.py",
        "matcher": ".*",
        "timeout_ms": 45000
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "python3 harness/hooks/subagent-start.py"
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python3 harness/hooks/subagent-stop.py"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 harness/hooks/stop-gate.py"
      }
    ]
  }
}
