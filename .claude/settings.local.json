{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit(/**)",
      "Read(/**)",
      "Bash",
      "Agent",
      "Task",
      "Skill",
      "Grep",
      "Glob",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "KillShell"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)"
    ]
  }
}
