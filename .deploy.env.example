# Copy to .deploy.env (gitignored) and fill in.

# SSH target
DEPLOY_SSH=aeroalgo@your-server

# Remote clones live under this base; local repo basename is appended:
#   local:  .../dev-hub  →  remote: $DEPLOY_REMOTE_BASE/dev-hub
DEPLOY_REMOTE_BASE=/path/to/repos

# Or set full path for this repo only (overrides BASE/basename):
# DEPLOY_REMOTE_DIR=/path/to/repos/dev-hub

# Optional: branch on remote (default = current local branch)
# DEPLOY_BRANCH=main

# Optional: after successful pull on server
# DEPLOY_REMOTE_CMD=docker compose up -d --build

# Optional: local test command (default: bin/pytest -q or .venv)
# TEST_CMD=bin/pytest -q
